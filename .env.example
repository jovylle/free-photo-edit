# free-photo-edit secrets — NEVER commit real values (gitignored).
# Engine switch: openai (default, ~2.6¢/edit) | workers-ai | pollinations
FREE_PHOTO_EDIT_ENGINE=openai
# OpenAI images/edits (primary engine, server-side only):
OPENAI_API_KEY=
# Cloudflare Workers AI (fallback engine; live edit path broken 2026-10-17):
CF_ACCOUNT_ID=7f0e409fd621476eb621ef4c9a436374
CLOUDFLARE_API_TOKEN=
# Pollinations fallback (stub-only in v1, unused):
POLLINATIONS_API_KEY=
FREE_CREDITS=3
PORT=8078
FREE_PHOTO_EDIT_DB=./api/credits.db
FREE_PHOTO_EDIT_STORAGE=./api/storage
# Abuse gates (public launch; rolling windows, no midnight logic):
# Cloudflare Turnstile — enforced when SECRET is set (dev: leave blank).
# Widget domains must cover every hostname you test from (dashboard:
# Turnstile > widget > Domains): freephoto.uft1.com + localhost +
# 127.0.0.1 (+ your LAN IP for phone testing, e.g. 192.168.1.47).
TURNSTILE_SITEKEY=
TURNSTILE_SECRET=
# Space-free, comma-separated. Prod: freephoto.uft1.com ONLY (never
# localhost/127.0.0.1 in prod). Dev: add 127.0.0.1,localhost[,LAN-IP].
TURNSTILE_HOSTNAMES=freephoto.uft1.com
IP_MINUTE_LIMIT=3
IP_DAILY_LIMIT=24
MAX_DAILY_EDITS=60
